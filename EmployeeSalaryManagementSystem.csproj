<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Exclude the test project's folder from this project's own file
       globbing — otherwise the main app tries to compile the test files
       too, and fails since it doesn't have the testing packages. -->
  <ItemGroup>
    <Compile Remove="EmpManagementSystem.Tests/**" />
    <Content Remove="EmpManagementSystem.Tests/**" />
    <EmbeddedResource Remove="EmpManagementSystem.Tests/**" />
    <None Remove="EmpManagementSystem.Tests/**" />
  </ItemGroup>

</Project>
